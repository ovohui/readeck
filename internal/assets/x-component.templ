package assets

import (
	"context"
	"encoding/xml"
	"io"
	"strconv"
	"strings"
)

var rotations = []string{"-12", "-10", " -8", " -6", "6", "8", "10", "12"}

templ (rd *random) svg() {
	@templ.Raw(xml.Header)
	{{ hue := rd.IntN(360) }}
	<svg
		xmlns="http://www.w3.org/2000/svg"
		version="1.1"
		viewBox="0 0 1024 576"
		width="1024"
		height="576"
	>
		<defs>
			<linearGradient
				id="gradient"
				x1="0%"
				y1="0%"
				x2="0%"
				y2="100%"
				gradientTransform={ "rotate(" + rotations[rd.IntN(len(rotations)-1)] + " 0.5 0.5)" }
			>
				<stop
					stop-color={ "hsl(" + strconv.Itoa(hue) + ",92%,70%)" }
					offset="0"
				></stop>
				<stop
					stop-color={ "hsl(" + strconv.Itoa(hue-60) + ",88%,60%)" }
					offset="1"
				></stop>
			</linearGradient>
			<filter
				id="filters"
				x="-20%"
				y="-20%"
				width="140%"
				height="140%"
				filterUnits="objectBoundingBox"
				primitiveUnits="userSpaceOnUse"
				color-interpolation-filters="sRGB"
			>
				<feTurbulence
					type="fractalNoise"
					baseFrequency="0.001 0.002"
					numOctaves="1"
					seed={ rd.IntN(50) }
					stitchTiles="stitch"
					result="noise"
				></feTurbulence>
				<feColorMatrix
					type="matrix"
					values="
						0.2126  0.7152 0.0722  0 0
						0.2126  0.7152 0.0722  0 0
						0.2126  0.7152 0.0722  0 0
						0 0 0 0 1"
					in="noise"
					result="mask"
				></feColorMatrix>
				<feGaussianBlur
					stdDeviation="80"
					in="mask"
					edgeMode="duplicate"
					result="blur"
				></feGaussianBlur>
				<feBlend
					mode="soft-light"
					in="SourceGraphic"
					in2="blur"
					result="blend"
				></feBlend>
			</filter>
		</defs>
		<rect width="100%" height="100%" fill="url(#gradient)" filter="url(#filters)" opacity="0.85"></rect>
		if (rd.letter != "") {
			{{ letter := strings.ToUpper(rd.letter) }}
			<svg height="200" y="188" fill={ "hsl(" + strconv.Itoa(hue-30) + ",80%,95%)" } overflow="visible">
				@svgLetter(letter, svgLetterDefault(letter))
			</svg>
		}
	</svg>
}

templ svgLetterDefault(letter string) {
	<text
		x="50%"
		y="50%"
		dominant-baseline="central"
		text-anchor="middle"
		font-family="sans-serif"
		font-size="200px"
		font-weight="300"
	>
		{ letter }
	</text>
}

func svgLetter(letter string, fallback templ.Component) templ.Component {
