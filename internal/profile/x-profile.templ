package profile

import (
	"codeberg.org/readeck/readeck/configs"
	"codeberg.org/readeck/readeck/internal/server"

	. "codeberg.org/readeck/readeck/components"
	F "codeberg.org/readeck/readeck/components/forms"
)

templ (v Views) userProfile(f *profileForm) {
	{{
		title := L(ctx).Gettext("My profile")
		user := server.GetUser(ctx)
	}}
	@v.base(title) {
		<h1 class="title text-h2">{ title }</h1>
		<form action={ URL(ctx, "/logout") } method="post" class="my-8">
			<p class="btn-block items-center">
				<span class="grow">
					@templ.Raw(L(ctx).Gettext("You are connected as <strong>%s</strong>",
						templ.EscapeString(user.Username)),
					)
				</span>
				<button type="submit" class="btn-outlined btn-danger">
					@Icon("o-logout")
					{ " " }
					<span>{ L(ctx).Gettext("Sign out") }</span>
				</button>
			</p>
		</form>
		@CustomTemplate("profile/extra.html.tmpl", nil)
		<form action={ URL(ctx) } method="post">
			@F.Errors(f)
			<fieldset class="mb-6">
				<legend class="title text-h3">{ L(ctx).Gettext("Base settings") }</legend>
				@F.TextField(&f.Username,
					F.Label(L(ctx).Gettext("Username")),
					F.Required(true),
					F.Classes("field-h"),
					F.InputAttr("disabled", user.IsExternal()),
				)
				@F.TextField(&f.Email,
					F.InputType("email"),
					F.Label(L(ctx).Gettext("Email Address")),
					F.Required(true),
					F.Classes("field-h"),
					F.InputAttr("disabled", user.IsExternal()),
				)
				@F.SelectField[string](&f.Settings.Lang,
					F.Label(L(ctx).Gettext("Language")),
					F.Required(true),
					F.Classes("field-h"),
				)
				<div class="field-h">
					<span class="field--spacer"></span>
					@Message(WithMessageClass("my-0")) {
						<details>
							<summary class="title my-0 hf:text-app-fg">Translate Readeck</summary>
							<p class="mt-2">You couldn't find your own language or you'd like to improve an existing translation?</p>
							<p>You can help with <a class="link" target="_blank" href="https://readeck.org/en/contribute#translations">translating Readeck.</a></p>
						</details>
					}
				</div>
			</fieldset>
			if HasPermission(ctx, "email", "send") {
				<fieldset class="mb-6">
					<legend class="title text-h3">{ L(ctx).Gettext("Email settings") }</legend>
					@F.TextField(&f.Settings.EmailReplyTo,
						F.InputType("email"),
						F.Label(L(ctx).Gettext("Reply To")),
						F.Classes("field-h"),
						F.Help(L(ctx).Gettext("Add this email address in your outgoing emails so recipients can reply.")),
					)
					@F.TextField(&f.Settings.EmailEpubTo,
						F.InputType("email"),
						F.Label(L(ctx).Gettext("Send EPUB to")),
						F.Classes("field-h"),
						F.Help(L(ctx).Gettext("This address is used to prefill the recipient when you send an e-book by email.")),
					)
					<div class="field-h">
						<span class="field--spacer"></span>
						@Message(WithMessageClass("my-0")) {
							<details>
								<summary class="title my-0 hf:text-app-fg">
									{ L(ctx).Gettext("Sending e-books to an Amazon Kindle") }
								</summary>
								<p class="mt-2">
									{ L(ctx).Gettext(`
										If you plan to send e-books to a Kindle device, you must approve the
										following email address within your Kindle Account:
									`) }
								</p>
								<p class="mt-2"><code>{ configs.Config.Email.FromNoReply.Addr() }</code></p>
							</details>
						}
					</div>
				</fieldset>
			}
			<fieldset class="mb-6">
				<legend class="title text-h3">{ L(ctx).Gettext("AI cleanup") }</legend>
				@F.CheckboxField(&f.Settings.AIEnabled,
					F.Label(L(ctx).Gettext("Enable AI cleanup")),
					F.Help(L(ctx).Gettext("Adds an “AI cleanup” button to bookmarks and the batch bar.")),
				)
				@F.SelectField[string](&f.Settings.AIProvider,
					F.Label(L(ctx).Gettext("Provider")),
					F.Classes("field-h"),
					F.Help(L(ctx).Gettext("OpenAI, DeepSeek, Moonshot, SiliconFlow, Ollama, Anthropic or any OpenAI-compatible endpoint.")),
				)
				@F.TextField(&f.Settings.AIBaseURL,
					F.Label(L(ctx).Gettext("Base URL")),
					F.Classes("field-h"),
					F.Help(L(ctx).Gettext("Leave empty for the provider default. SiliconFlow: https://api.siliconflow.cn/v1")),
				)
				@F.TextField(&f.Settings.AIModel,
					F.Label(L(ctx).Gettext("Model")),
					F.Classes("field-h"),
					F.Help(L(ctx).Gettext("Leave empty for the provider default.")),
				)
				@F.TextField(&f.Settings.AIVisionModel,
					F.Label(L(ctx).Gettext("Vision model")),
					F.Classes("field-h"),
					F.Help(L(ctx).Gettext("Optional multimodal model for reading text from images.")),
				)
				@F.TextField(&f.Settings.AIAPIKey,
					F.Label(L(ctx).Gettext("API key")),
					F.InputType("password"),
					F.InputAttr("autocomplete", "new-password"),
					F.InputAttr("autocapitalize", "off"),
					F.InputAttr("spellcheck", "false"),
					F.Classes("field-h"),
					F.Help(L(ctx).Gettext("Stored on this server. Leave empty to keep the current key.")),
				)
			</fieldset>
			<p class="btn-block flex flex-wrap items-center gap-3" data-controller="ai-test">
				<button class="btn btn-primary" type="submit">{ L(ctx).Gettext("Save") }</button>
				<button class="btn btn-outlined" type="button" data-action="ai-test#test">
					{ L(ctx).Gettext("Test connection") }
				</button>
				<span class="text-sm" data-ai-test-target="result"></span>
			</p>
		</form>
	}
}
