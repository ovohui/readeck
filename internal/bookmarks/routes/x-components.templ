package routes

import (
	"io"
	"net/url"
	"strings"

	"codeberg.org/readeck/readeck/internal/bookmarks/dataset"
	"codeberg.org/readeck/readeck/internal/server"
	"codeberg.org/readeck/readeck/internal/server/urls"

	. "codeberg.org/readeck/readeck/components"
)

type Components struct{}

templ (c Components) titleBlock(item *dataset.Bookmark) {
	<turbo-frame id={ "bookmark-title-" + item.ID } class="leading-normal">
		<h1>{ displayTitle(item) }</h1>
		if desc := displayDescription(item); desc != "" {
			<p
				class="bookmark-summary"
				title={ desc }
				dir={ Tern(func() bool { return item.TextDirection != "" }, item.TextDirection, "ltr") }
			>
				{ desc }
			</p>
		}
		@c.bookmarkKicker(item)
		@c.note(item)
		@c.editDialog(item)
	</turbo-frame>
}

// bookmarkKicker is the small line under the title: what kind of page this is,
// where it comes from, who wrote it and when, plus a way back to the original
// page. The sidebar repeats some of it on wide screens, but the sidebar is
// hidden on phones - and on a video page "open the original" is the one action
// that is always useful.
templ (c Components) bookmarkKicker(item *dataset.Bookmark) {
	<div class="bookmark-kicker">
		if item.Type == "video" {
			<span class="bookmark-kind">@Icon("o-video", WithIconSvgClass("w-3.5 h-3.5")){ L(ctx).Gettext("Video") }</span>
		} else if item.Type == "photo" {
			<span class="bookmark-kind">@Icon("o-photo", WithIconSvgClass("w-3.5 h-3.5")){ L(ctx).Gettext("Pictures") }</span>
		}
		if item.SiteName != "" {
			<span class="bookmark-kicker-site">{ item.SiteName }</span>
		}
		if len(item.Authors) > 0 {
			<span class="bookmark-kicker-sep">·</span>
			<span class="bookmark-kicker-author" title={ strings.Join(item.Authors, ", ") }>
				{ authorLine(item) }
			</span>
		}
		if item.Published != nil {
			<span class="bookmark-kicker-sep">·</span>
			<span>{ LocalDate(ctx, *item.Published) }</span>
		}
		<a
			class="bookmark-origin"
			href={ item.URL }
			target="_blank"
			rel="noopener noreferrer"
			title={ L(ctx).Gettext("Open link") }
		>
			@Icon("o-link-ext", WithIconSvgClass("w-3.5 h-3.5"))
			{ L(ctx).Gettext("Open link") }
		</a>
		if HasPermission(ctx, "bookmarks", "write") {
			<a
				class="bookmark-cover-edit"
				href={ URL(ctx, "/bookmarks", item.ID, "cover") }
				title={ L(ctx).Gettext("Bookmark cover") }
			>
				@Icon("o-photo", WithIconSvgClass("w-3.5 h-3.5"))
				{ L(ctx).Gettext("Cover") }
			</a>
		}
	</div>
}

templ (c Components) editDialog(item *dataset.Bookmark) {
	<dialog class="dialog max-w-std" id="bookmark-update-dialog" data-turbo="true">
		<form class="dialog--top" method="dialog">
			<button class="dialog--close" title={ L(ctx).Gettext("Close dialog") }>
				@Icon("o-close", WithIconClass(), WithIconSvgClass("h-8 w-8"))
			</button>
		</form>
		<div class="dialog--content">
			<turbo-frame
				id={ "bookmark-update-" + item.ID }
				src={ URL(ctx, "/bookmarks", item.ID, "update") }
				loading="lazy"
			></turbo-frame>
		</div>
		<div class="dialog--footer">
			<button class="btn btn-primary ml-auto" form="bookmark-update-form" type="submit">
				{ L(ctx).Gettext("Save") }
			</button>
		</div>
	</dialog>
}

templ (c Components) contentBlock(item *dataset.Bookmark, html io.Reader) {
	switch item.Type {
		case "photo":
			if img, ok := item.Resources["image"]; ok {
				<figure class="mb-8">
					<img alt="" src={ img.Src } class="mx-auto" width={ img.Width } height={ img.Height }/>
				</figure>
			}
		case "video":
			// A bookmark that kept an article already carries the playable
			// thing: the archived <video>, or the cover placeholder the
			// content script left for the original player. Showing the embed
			// player on top of it gave the reader the same cover twice and,
			// on Bilibili, a second, slower player above the offline one.
			if !item.HasArticle {
				if img, ok := item.Resources["image"]; ok && item.Embed != "" {
					<div class="video-player mb-8" data-controller="video">
						<img alt="" src={ img.Src } width={ img.Width } height={ img.Height }/>
						<template data-video-target="embed">
							@templ.Raw(item.Embed)
						</template>
						<template data-video-target="play">
							<button
								class="play-button"
								data-action="click->scroll-progress#setPosition click->video#play"
								data-scroll-progress-position-param="100"
							>
								<span></span>
							</button>
						</template>
					</div>
				}
			}
	}
	if showHero(item) {
		if img, ok := item.Resources["image"]; ok {
			<figure class="bookmark-hero">
				<img src={ img.Src } width={ img.Width } height={ img.Height } alt=""/>
			</figure>
		}
	}
	@c.articleContent(item, html)
	@c.qrCode(item)
}

templ (c Components) articleContent(item *dataset.Bookmark, html io.Reader) {
	if item.HasArticle {
		{{
			raw, _ := io.ReadAll(html)
			prepared := prepareArticleHTML(item, string(raw))
			prefs := Preferences(ctx)
		}}
		if prepared == "" {
			@c.emptyContent(item)
		} else {
			<turbo-frame
				id={ "bookmark-content-" + item.ID }
				src={ URL(ctx, "/api/bookmarks", item.ID, "article") }
				disabled
				data-controller="annotations"
				data-action="request:annotation-removed@document->annotations#reload"
				data-annotations-api-url-value={ URL(ctx, "/api/bookmarks", item.ID, "annotations") }
				data-annotations-hidden-class="hidden"
			>
				<div
					class={
						"bookmark-article print:max-w-none relative",
						templ.KV("bookmark-article--video", item.Type == "video"),
						templ.KV("bookmark-article--photo", item.Type == "photo"),
						prefs.Bookmark.ReaderWidth.Class(),
					}
					data-controller="styler"
				>
					@c.articleAnnotator()
					<div
						class={
							"prose", "overflow-x-auto",
							prefs.Bookmark.FontFamily.Class(),
							prefs.Bookmark.FontSize.Class(),
							prefs.Bookmark.LineHeight.Class(),
							prefs.Bookmark.Justified.Class(),
							prefs.Bookmark.Hyphenated.Class(),
						}
						lang={ item.Lang }
						dir={ Tern(func() bool { return item.TextDirection != "" }, item.TextDirection, "ltr") }
						data-controller="styler modal-images modal-videos"
						data-modal-images-selector-value="img[src]:not([data-iframe-params])"
						data-modal-videos-selector-value="img[data-iframe-params]"
						data-modal-videos-base-url-value={ URL(ctx, "/videoplayer") + "?type=embed" }
						data-annotations-target="root"
						data-scroll-progress-target="tracked"
						data-action="turbo:morph-element->modal-images#reload turbo:morph-element->modal-videos#reload"
					>
						@templ.Raw(prepared)
						@c.imageModal()
						@c.videoModal()
					</div>
				</div>
			</turbo-frame>
		}
	} else {
		@c.emptyContent(item)
	}
}

// emptyContent is what the reader shows when there is nothing to read: a
// JavaScript-only page, a login wall, or a failed extraction. Blank paper with
// a title is the worst possible answer; say what happened and give the one
// action that works.
templ (c Components) emptyContent(item *dataset.Bookmark) {
	<div class="bookmark-empty">
		if img, ok := item.Resources["image"]; ok {
			<img class="bookmark-empty-image" alt="" src={ img.Src } width={ img.Width } height={ img.Height }/>
		}
		<div class="bookmark-empty-body">
			<p class="bookmark-empty-title">{ L(ctx).Gettext("No readable content was saved") }</p>
			<p class="bookmark-empty-text">
				{ L(ctx).Gettext("This page is rendered by JavaScript or requires a login. Open the original page, or save it again with the browser extension.") }
			</p>
			<div class="bookmark-empty-actions">
				<a class="btn btn-primary" href={ item.URL } target="_blank" rel="noopener noreferrer">
					@Icon("o-link-ext", WithIconSvgClass("w-4 h-4"))
					{ L(ctx).Gettext("Open link") }
				</a>
				<a class="btn" href={ URL(ctx, "/cookies") }>
					@Icon("o-key", WithIconSvgClass("w-4 h-4"))
					{ L(ctx).Gettext("Site Cookies") }
				</a>
			</div>
		</div>
	</div>
}

templ (c Components) articleAnnotator() {
	{{
		colors := [][2]string{
			{"yellow", L(ctx).Gettext("Yellow")},
			{"red", L(ctx).Gettext("Red")},
			{"blue", L(ctx).Gettext("Blue")},
			{"green", L(ctx).Gettext("Green")},
			{"none", L(ctx).Gettext("Transparent")},
		}
	}}
	<div class="annotator hidden" data-annotations-target="controls">
		<div class="annotator--arrow" data-annotations-target="arrow"></div>
		<div class="annotator--content">
			<div class="annotator--colors">
				{ L(ctx).Gettext("Highlight") }
				for _, c := range colors {
					<input
						type="radio"
						name="color"
						value={ c[0] }
						aria-label={ c[1] }
						data-annotations-target="color"
					/>
				}
			</div>
			<div class="flex flex-col">
				<label for="annotation-note" data-annotations-target="whenNew whenOne">
					{ L(ctx).Gettext("Note") }:
				</label>
				<textarea
					class="form-textarea select-none"
					id="annotation-note"
					name="note"
					rows="3"
					cols="45"
					maxlength="1024"
					data-annotations-target="note whenNew whenOne"
				></textarea>
			</div>
			<div class="flex">
				<button
					class="btn btn-primary"
					data-action="click->annotations#create"
					data-annotations-target="whenNew"
				>{ L(ctx).Gettext("Save") }</button>
				<button
					class="btn btn-primary"
					data-action="click->annotations#update"
					data-annotations-target="whenOne whenMany"
				>{ L(ctx).Gettext("Save") }</button>
				<button
					class="btn-outlined btn-danger ml-auto"
					data-action="click->annotations#delete"
					data-annotations-target="whenOne whenMany"
				>
					@Icon("o-trash")
					<span class="sr-only">{ L(ctx).Gettext("Delete") }</span>
				</button>
			</div>
		</div>
	</div>
}

templ (c Components) note(item *dataset.Bookmark) {
	if len(item.Note) > 0 {
		@Message( //
			WithMessageIcon("o-pin"),
			WithMessageType(""),
			WithMessageClass("bookmark-note"),
		) {
			<details open>
				<summary>{ L(ctx).Gettext("Note") }</summary>
				<div class="prose">
					@Markdown(item.Note)
				</div>
			</details>
		}
	}
}

templ (c Components) bookmarkInfoBottomActions(b *dataset.Bookmark) {
	<turbo-frame id={ "bookmark-bottom-actions-" + b.ID }>
		<form
			action={ URL(ctx, "/bookmarks", b.ID, "update") }
			method="post"
			class="flex flex-row max-sm:flex-col justify-center"
			data-controller="turbo-form"
		>
			<input type="hidden" name="_to" value={ CurrentPath(ctx) }/>
			<button
				class="btn-outlined btn-primary rounded-full whitespace-nowrap mb-0 mr-4 max-sm:mr-0 max-sm:mb-2"
				name="is_marked"
				value={ Tern(func() bool { return b.IsMarked }, 0, 1) }
			>
				@Icon(Tern(func() bool { return b.IsMarked }, "o-favorite-on", "o-favorite-off"))
				{ " " }
				{ Tern(func() bool { return b.IsMarked },
					L(ctx).Gettext("Remove from favorites"),
					L(ctx).Gettext("Add to favorites"),
				) }
			</button>
			<button
				class="btn-outlined btn-primary rounded-full whitespace-nowrap"
				name="is_archived"
				value={ Tern(func() bool { return b.IsArchived }, 0, 1) }
			>
				@Icon(Tern(func() bool { return b.IsArchived }, "o-archive-on", "o-archive-off"))
				{ " " }
				{ Tern(func() bool { return b.IsArchived },
					L(ctx).Gettext("Remove from archive"),
					L(ctx).Gettext("Move to archive"),
				) }
			</button>
		</form>
	</turbo-frame>
}

templ (c Components) imageModal() {
	<dialog class="dialog-image font-sans" data-modal-images-target="dialog">
		<form method="dialog">
			<button class="dialog--close" title={ L(ctx).Gettext("Close") }>
				@Icon("o-close", WithIconSvgClass("w-8"))
			</button>
		</form>
		<div>
			<img alt="" data-modal-images-target="img"/>
		</div>
	</dialog>
	<template data-modal-images-target="trigger">
		<span class="block w-fit relative group">
			<button
				type="button"
				title={ L(ctx).Gettext("Show image") }
				class="
					absolute top-0 right-0 p-2 z-10
					text-white bg-black/30 rounded-bl rounded-tr drop-shadow
					block opacity-0
					group-hfw:opacity-100 hfw:bg-black/30 hfw:ring-0
				 "
				data-action="click->scroll-progress#skip"
			>
				@Icon("o-expand", WithIconSvgClass("h-6"))
			</button>
		</span>
	</template>
}

templ (c Components) videoModal() {
	<dialog class="dialog-video font-sans" data-modal-videos-target="dialog">
		<form method="dialog">
			<button class="dialog--close" title={ L(ctx).Gettext("Close") }>
				@Icon("o-close", WithIconSvgClass("w-8"))
			</button>
		</form>
		<div>
			<iframe src="" frameborder="0"></iframe>
		</div>
	</dialog>
	<template data-modal-videos-target="trigger">
		<span class="block relative group">
			<button
				type="button"
				title={ L(ctx).Gettext("Play video") }
				class="
					absolute w-full h-full z-10 cursor-pointer
					decoration-none text-white bg-black/10 rounded-bl rounded-tr drop-shadow
					flex items-center justify-center
					opacity-0
					group-hfw:opacity-100 hfw:bg-black/10 hfw:ring-0
				 "
				data-action="click->scroll-progress#skip"
			>
				@Icon("o-expand", WithIconClass("p-4 rounded bg-black/50"), WithIconSvgClass("w-8 h-8"))
			</button>
		</span>
	</template>
}

templ (c Components) diagnosis(d *dataset.BookmarkDiagnosis) {
	{{
		levelMap := map[string]string{
			"DEBU": "text-gray-400",
			"INFO": "text-green-700",
			"WARN": "text-yellow-700",
			"ERRO": "text-red-700",
		}
		user := server.GetUser(ctx)
	}}
	<div class="dialog--content" data-controller="clipboard">
		<h4 class="mb-1 title text-lg">{ L(ctx).Gettext("Extraction log") }</h4>
		<button type="button" class="link" data-action="clipboard#copy">
			@Icon("o-copy")
			{ " " }
			{ L(ctx).Gettext("copy to clipboard") }
		</button>
		<textarea class="hidden" data-clipboard-target="content">```&#13;{ string(d.Log) }&#13;```</textarea>
		<ul class="mt-2 w-full text-xs font-mono">
			for _, l := range d.LogLines() {
				<li class="flex gap-2">
					<span class={ levelMap[l.Level] }>[{ l.Level }]</span>
					<span class="grow wrap-anywhere">{ l.Line }</span>
				</li>
			}
		</ul>
		if user.Settings.DebugInfo {
			<h4 class="mt-2 mb-1 title text-lg">{ L(ctx).Gettext("Properties") }</h4>
			<pre class="text-xs leading-5">{ string(d.Props) }</pre>
		}
	</div>
}

templ (c Components) qrCode(item *dataset.Bookmark) {
	<div class="hidden print:flex gap-4 mt-8 pt-4 border-t border-gray-700">
		<div>
			<p class="font-semibold">{ L(ctx).Gettext("Saved with Readeck") } (https://readeck.com/)</p>
			<p class="break-all">{ item.Href }</p>
		</div>
		<div class="ml-auto">
			<img src={ QRCodeB64(item.Href, ColorPrimary, -2) } alt="" class="rounded"/>
		</div>
	</div>
}

templ (c Components) feedDialog(q url.Values) {
	<dialog class="dialog max-w-std" id="atom-feed">
		<form class="dialog--top" method="dialog">
			<button class="dialog--close" title={ L(ctx).Gettext("Close dialog") }>
				@Icon("o-close", WithIconClass(""), WithIconSvgClass("h-8 w-8"))
			</button>
		</form>
		<div class="dialog--content">
			<p>{ L(ctx).Gettext("This feed provides the latest entries from this bookmark list") }</p>
			<p class="mt-2">{ L(ctx).Gettext("Subscribe to this feed by copying the URL below:") }</p>
			<p class="mt-2 text-sm flex gap-2 items-center" data-controller="clipboard">
				<input
					class="w-full form-input"
					type="text"
					readonly
					value={ urls.AbsoluteURLContext(ctx, "/api/bookmarks/feed").String() + "?" + q.Encode() }
					data-clipboard-target="content"
				/>
				<button
					class="btn btn-primary btn-outlined"
					type="button"
					title={ L(ctx).Gettext("copy to clipboard") }
					data-action="clipboard#copy"
				>
					@Icon("o-copy")
				</button>
				<a
					class="btn btn-primary btn-outlined"
					title={ L(ctx).Gettext("Open link") }
					href={ string(URL(ctx, "/api/bookmarks/feed")) + "?" + q.Encode() }
					target="_blank"
				>
					@Icon("o-link")
				</a>
			</p>
			@Message() {
				<strong>{ L(ctx).Gettext("Access to this feed is restricted.") }</strong>
				<br/>
				@templ.Raw(L(ctx).Gettext(`
						You must provide your newsreader app a username and an
						<a class="%[1]s" href="%[2]s">API Token</a> to load this feed.
					`, "link", templ.EscapeString(URL(ctx, "/profile/tokens")),
				))
			}
		</div>
	</dialog>
}

templ (c Components) TextWelcome() {
	@templ.Raw(L(ctx).Gettext(
		"You don't have any bookmarks yet.<br> Copy a link in the field above and start saving.",
	))
}

templ (c Components) TextWelcomeDocs() {
	@templ.Raw(L(ctx).Gettext(
		`Read more about bookmarks in the <a class="%s" href="%s">documentation</a>.`,
		"link",
		URL(ctx, "/docs"),
	))
}

templ (c Components) TextExtension() {
	{ L(ctx).Gettext(`
		With the Browser Extension, you can save pages, images and selections
		directly from your browser!`,
	) }
}

templ (c Components) TextImport() {
	{ L(ctx).Gettext(`
		Would you like to import from a similar tool or from a file with existing bookmarks?
		Try Readeck's import tool.
	`) }
}
