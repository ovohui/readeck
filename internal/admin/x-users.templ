package admin

import (
	"codeberg.org/readeck/readeck/internal/server"
	"codeberg.org/readeck/readeck/pkg/utils"

	. "codeberg.org/readeck/readeck/components"
	F "codeberg.org/readeck/readeck/components/forms"
)

templ (v Views) userList(ul *userList) {
	{{ title := L(ctx).Gettext("Users") }}
	@v.base(title) {
		<h1 class="title text-h2">{ title }</h1>
		<p><a href={ URL(ctx, ".", "add") } class="btn btn-primary">{ L(ctx).Gettext("Add a new user") }</a></p>
		if len(ul.Items) > 0 {
			@Pagination(&ul.Pagination)
			<turbo-frame
				id="user-list"
				data-controller="turbo-refresh"
				data-turbo-refresh-interval-value="10"
				data-turbo-refresh-on-value="[data-user-deleted='true']"
			>
				@List("my-6") {
					for _, u := range ul.Items {
						@ListItem("flex gap-2 items-center hfw:bg-gray-100 max-md:block") {
							<a class="block sm:flex items-center flex-grow p-4" href={ URL(ctx, ".", u.ID) }>
								<span class="grow inline-flex gap-2 items-center">
									<strong class="link font-semibold">{ u.Username }</strong>
									({ u.Group })
									if u.IsExternal {
										@Icon("o-ext-auth",
											WithIconClass("text-blue-800"),
											WithIconAttrs(templ.Attributes{"title": L(ctx).Gettext("External User")}),
										)
									}
									if u.ID == server.GetUser(ctx).UID {
										@Icon("o-user",
											WithIconClass("text-green-700"),
											WithIconAttrs(templ.Attributes{"title": L(ctx).Gettext("This is you!")}),
										)
									}
								</span>
								<small class="block sm:text-right">
									if !u.LastLogin.IsZero() {
										{ L(ctx).Gettext("Last login: %s", Strftime(ctx, u.LastLogin, "%e %B %Y %H:%M")) }
									}
								</small>
							</a>
							if u.IsDeleted {
								<div class="flex items-center max-w-xs m-4 max-md:mt-0" data-user-deleted="true">
									<span class="text-red-700 text-xs font-semibold">
										{ L(ctx).Gettext("This user will be removed in a few seconds.") }
									</span>
									<form action={ URL(ctx, ".", u.ID, "delete") } method="post">
										<input type="hidden" name="cancel" value="1"/>
										<button type="submit" class="btn btn-primary whitespace-nowrap text-sm py-1 ml-2">
											@Icon("o-undo")
											{ "" }
											{ L(ctx).Gettext("Cancel") }
										</button>
									</form>
								</div>
							}
						}
					}
				}
			</turbo-frame>
			@Pagination(&ul.Pagination)
		}
	}
}

templ (v Views) userCreate(f *userForm) {
	{{ title := L(ctx).Gettext("New User") }}
	@v.base(title) {
		<h1 class="title text-h2">{ title }</h1>
		<form action={ URL(ctx) } method="post">
			@F.Errors(f)
			@F.TextField(&f.Username,
				F.Label(L(ctx).Gettext("Username")),
				F.Required(true),
				F.Classes("field-h"),
			)
			@F.TextField(&f.Email,
				F.InputType("email"),
				F.Label(L(ctx).Gettext("Email address")),
				F.Required(true),
				F.Classes("field-h"),
			)
			@F.SelectField[string](&f.Group,
				F.Label(L(ctx).Gettext("Group")),
				F.Required(true),
				F.Classes("field-h"),
			)
			@F.PasswordField(&f.Password,
				F.Label(L(ctx).Gettext("Password")),
				F.Required(true),
				F.Classes("field-h"),
				F.InputAttr("autocomplete", "off"),
			)
			<p class="btn-block">
				<button class="btn btn-primary" type="submit">{ L(ctx).Gettext("Create user") }</button>
			</p>
		</form>
	}
}

templ (v Views) userInfo(f *userForm, u *extendedUserItem) {
	{{
		title := L(ctx).Gettext("Users") + " - " + u.Username
		user := server.GetUser(ctx)
	}}
	@v.base(title) {
		<h1 class="title text-h2">
			{ u.Username }
			if u.ID == user.UID {
				<span class="text-lg text-green-700">
					({ L(ctx).Gettext("This is you!") })
				</span>
			}
		</h1>
		<h2 class="title text-h3">{ L(ctx).Gettext("User information") }</h2>
		<form class="mb-8" action={ URL(ctx) } method="post">
			@F.Errors(f)
			@F.TextField(&f.Username,
				F.Label(L(ctx).Gettext("Username")),
				F.Required(true),
				F.Classes("field-h"),
				F.InputAttr("disabled", f.user.IsExternal()),
			)
			@F.TextField(&f.Email,
				F.InputType("email"),
				F.Label(L(ctx).Gettext("Email address")),
				F.Required(true),
				F.Classes("field-h"),
				F.InputAttr("disabled", f.user.IsExternal()),
			)
			@F.SelectField[string](&f.Group,
				F.Label(L(ctx).Gettext("Group")),
				F.Required(true),
				F.Classes("field-h"),
				F.InputAttr("disabled", f.user.IsExternal()),
			)
			if !f.user.IsExternal() {
				@F.PasswordField(&f.Password,
					F.Label(L(ctx).Gettext("Password")),
					F.Classes("field-h"),
					F.InputAttr("autocomplete", "off"),
					F.Help(L(ctx).Gettext("will not change if empty")),
				)
			}
			if !f.user.IsExternal() {
				<div class="btn-block">
					<button class="btn btn-primary" type="submit">{ L(ctx).Gettext("Save") }</button>
				</div>
			}
		</form>
		<div class="field field-h sm:mb-0.5">
			<label>{ L(ctx).Gettext("Created on") }</label>
			<div class="control">
				{ Strftime(ctx, u.Created, "%e %B %Y %H:%M") }
			</div>
		</div>
		if !u.LastLogin.IsZero() {
			<div class="field field-h sm:mb-0.5">
				<label>{ L(ctx).Gettext("Last Login") }</label>
				<div class="control">
					{ Strftime(ctx, u.LastLogin, "%e %B %Y %H:%M") }
				</div>
			</div>
		}
		if !u.LastActivity.IsZero() {
			<div class="field field-h sm:mb-0.5">
				<label>{ L(ctx).Gettext("Last Activity") }</label>
				<div class="control">
					{ Strftime(ctx, u.LastActivity, "%e %B %Y %H:%M") }
				</div>
			</div>
		}
		<div class="field field-h sm:mb-0.5">
			<label>{ L(ctx).Gettext("Bookmarks") }</label>
			<div class="control">{ u.BookmarkCount }</div>
		</div>
		<div class="field field-h sm:mb-0.5">
			<label>{ L(ctx).Gettext("Disk Usage") }</label>
			<div class="control">{ utils.FormatBytes(u.BookmarkDiskUsage) }</div>
		</div>
		<h2 class="title text-h3 mt-8">{ L(ctx).Gettext("User Administration") }</h2>
		@List("my-6") {
			if u.IsDeleted {
				@ListItem() {
					<form class="flex gap-4 items-baseline max-md:flex-col" action={ URL(ctx, ".", "delete") } method="POST">
						<p class="grow">
							{ L(ctx).Gettext("User will be removed in a few seconds") }
							<input type="hidden" name="_to" value={ CurrentPath(ctx) }/>
						</p>
						<button class="btn btn-primary" name="cancel" value="1">{ L(ctx).Gettext("Cancel") }</button>
					</form>
				}
			} else {
				@ListItem() {
					<form class="flex gap-4 items-baseline max-md:flex-col" action={ URL(ctx, ".", "signout") } method="post">
						<p class="grow">
							{ L(ctx).Gettext("This will sign this user out of all active sessions on the web application.") }
						</p>
						<button class="btn-outlined btn-primary" name="detach" value="1">
							@Icon("o-logout")
							{ " " }
							{ L(ctx).Gettext("Sign this user out") }
						</button>
					</form>
				}
				if f.user.IsExternal() {
					@ListItem() {
						<form class="flex gap-4 items-baseline max-md:flex-col" action={ URL(ctx, ".", "detach") } method="post">
							<p class="grow">
								@templ.Raw(L(ctx).Gettext(`
									This user is attached to an external authentication provider:<br />
									<strong>%[1]s</strong>.<br />
									Therefore, some of their properties are not editable.<br />
									This will detach the user <strong>%[2]s</strong>.
								`,
									templ.EscapeString(f.user.ExtInfo.Issuer),
									templ.EscapeString(f.user.Username),
								))
							</p>
							<button class="btn-outlined btn-primary" name="detach" value="1">
								@Icon("o-ext-auth")
								{ " " }
								{ L(ctx).Gettext("Detach this user") }
							</button>
						</form>
					}
				}
				if u.ID != user.UID && !u.IsDeleted {
					@ListItem() {
						<form class="flex gap-4 items-baseline max-md:flex-col" action={ URL(ctx, ".", "delete") } method="post">
							<p class="grow">
								@templ.Raw(L(ctx).Gettext(
									`This will delete the user <strong>%s</strong> and all their contents.`,
									templ.EscapeString(u.Username),
								))
							</p>
							<button class="btn-outlined btn-danger" type="submit">
								@Icon("o-trash")
								{ " " }
								{ L(ctx).Gettext("Delete this user") }
							</button>
						</form>
					}
				}
			}
		}
	}
}
