{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "commonjs",
    "alwaysStrict": true,
    "strict": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "checkJs": false
  },
  "include": ["*.ts", "src/**/*.js", "src/**/*.ts"],
}