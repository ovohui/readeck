# NOTE: this file is not used for container image releases.
# See tools/build-container for that specific job.
#
# This is a Containerfile/Dockerfile you can use to build a version of Readeck
# based on any branch or tag.
# It builds a container in Debian and copies the resulting Readeck binary
# to a Busybox image.
# You can build an optimized AMD64 build using the "GOAMD64" build argument.
#
# Building reads like:
#   docker build -t readeck:main -f tools/Containerfile .

# First stage, build Readeck
FROM debian:trixie-slim as build

# TARGETARCH is provided by buildx (amd64 / arm64). Using it for the Go
# tarball lets the same Containerfile build on both x86 and ARM NAS devices.
ARG TARGETARCH=amd64
ARG TARGETOS=linux

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-transport-https \
        ca-certificates \
        curl \
        build-essential \
        python3-venv \
        && \
    apt-get clean

# Install nodejs
COPY <<"EOT" /etc/apt/sources.list.d/nodejs.list
deb https://deb.nodesource.com/node_22.x nodistro main
EOT

COPY <<"EOT" /etc/apt/preferences.d/nodejs
Package: nodejs
Pin: origin deb.nodesource.com
Pin-Priority: 600
EOT

RUN curl -sSL -o /etc/apt/trusted.gpg.d/nodesource.gpg.asc "https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nodejs \
        && \
    apt-get clean

# Install Go (must match the version required by go.mod).
# TARGETARCH is provided by buildx (amd64 / arm64).
RUN curl -s -L "https://dl.google.com/go/go1.27.4.${TARGETOS}-${TARGETARCH}.tar.gz" \
    | tar xvz -C /usr/local

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv* /bin/

# ✀ -------------------------------------------------------------------
# The lines above are a good base for a development container!

# Compile Readeck
COPY --link ./ /workspace/readeck
RUN ls -al /workspace/readeck

WORKDIR /workspace/readeck
ENV PATH="/usr/local/go/bin:${PATH}"
# Readeck uses modernc.org/sqlite (pure Go), so no CGO is required. Disabling
# it avoids cross-compiler errors when building arm64 under emulation and
# produces a fully static binary without external linking.
ENV CGO_ENABLED=0
ENV LDFLAGS='-s -w'
ARG GOAMD64=v1

RUN make setup generate build

# Second stage
# The runtime ships ffmpeg and yt-dlp so videos behind embedded players
# (YouTube, Bilibili, ...) can be downloaded into the archive.
# Alpine is used on purpose: the Debian equivalent (apt ffmpeg + python venv)
# produced a 179 MB layer, which is painfully slow to pull on a NAS. With
# Alpine's ffmpeg package and the static musl yt-dlp binary the same runtime
# fits in roughly a third of that.
FROM docker.io/library/alpine:3.22

ARG TARGETARCH=amd64

RUN apk add --no-cache \
        ca-certificates \
        ffmpeg \
        tzdata

# yt-dlp publishes self-contained musl binaries, so no Python is needed in the
# image. YTDLP_VERSION can be pinned to a tag (e.g. 2026.10.26) for
# reproducible builds; the default always tracks the latest release.
ARG YTDLP_VERSION=latest
RUN case "$TARGETARCH" in \
        amd64) asset=yt-dlp_musllinux ;; \
        arm64) asset=yt-dlp_musllinux_aarch64 ;; \
        *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    wget -q -O /usr/local/bin/yt-dlp \
        "https://github.com/yt-dlp/yt-dlp/releases/${YTDLP_VERSION}/download/${asset}" && \
    chmod 0755 /usr/local/bin/yt-dlp

# Fail the build early if the tools cannot run on this architecture.
RUN yt-dlp --version && ffmpeg -hide_banner -version | head -n 1

COPY --from=build /workspace/readeck/dist/readeck /bin/readeck

LABEL org.opencontainers.image.url=https://codeberg.org/readeck/readeck
WORKDIR /readeck
VOLUME /readeck
EXPOSE 8000/tcp
ENV READECK_SERVER_HOST=0.0.0.0
ENV READECK_SERVER_PORT=
CMD ["/bin/readeck", "serve", "-config", "config.toml"]