# NOTE: this file is not used for container image releases.
# See tools/build-container for that specific job.
#
# This is a Containerfile/Dockerfile you can use to build a version of Readeck
# based on any branch or tag.
# It builds a container in Debian and copies the resulting Readeck binary
# to a Busybox image.
# You can build an optimized AMD64 build using the "GOAMD64" build argument.
#
# Building reads like:
#   docker build -t readeck:main -f tools/Containerfile .

# First stage, build Readeck
FROM debian:trixie-slim as build

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-transport-https \
        ca-certificates \
        curl \
        build-essential \
        python3-venv \
        && \
    apt-get clean

# Install nodejs
COPY <<"EOT" /etc/apt/sources.list.d/nodejs.list
deb https://deb.nodesource.com/node_22.x nodistro main
EOT

COPY <<"EOT" /etc/apt/preferences.d/nodejs
Package: nodejs
Pin: origin deb.nodesource.com
Pin-Priority: 600
EOT

RUN curl -sSL -o /etc/apt/trusted.gpg.d/nodesource.gpg.asc "https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nodejs \
        && \
    apt-get clean

# Install Go
RUN curl -s -L https://dl.google.com/go/go1.26.4.linux-amd64.tar.gz \
    | tar xvz -C /usr/local

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv* /bin/

# ✀ -------------------------------------------------------------------
# The lines above are a good base for a development container!

# Compile Readeck
COPY --link ./ /workspace/readeck
RUN ls -al /workspace/readeck

WORKDIR /workspace/readeck
ENV PATH="/usr/local/go/bin:${PATH}"
ENV LDFLAGS='-linkmode external -extldflags "-static" -s -w'
ARG GOAMD64=v1

RUN make setup generate build

# Second stage
FROM docker.io/library/busybox:uclibc
COPY --from=docker.io/library/alpine:latest /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /workspace/readeck/dist/readeck /bin/readeck

LABEL org.opencontainers.image.url=https://codeberg.org/readeck/readeck
WORKDIR /readeck
VOLUME /readeck
EXPOSE 8000/tcp
ENV READECK_SERVER_HOST=0.0.0.0
ENV READECK_SERVER_PORT=
CMD ["/bin/readeck", "serve", "-config", "config.toml"]