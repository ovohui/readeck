package components

import "net/http"

templ DefaultError(status int) {
	@Page(L(ctx).Gettext("Error")) {
		<div class="mt-8 text-center">
			<h1 class="text-h1 title">{ L(ctx).Gettext("Error") }</h1>
			<p class="mb-4 text-lg font-semibold">
				switch status {
					case http.StatusForbidden:
						{ L(ctx).Gettext("Permission denied.") }
					case http.StatusNotFound:
						{ L(ctx).Gettext("Page not found.") }
					default:
						{ L(ctx).Gettext("An error occurred.") }
				}
			</p>
			<p>
				<a class="link" href={ URL(ctx, "/") }>{ L(ctx).Gettext("Back to home page") }</a>
			</p>
		</div>
	}
}
