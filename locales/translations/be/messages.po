"\t\t\t\t\t\t\t\t\tTherefore, some of their properties are not editable.<br />\n"
"\t\t\t\t\t\t\t\t\tThis will detach the user <strong>%[2]s</strong>.\n"
"\t\t\t\t\t\t\t\t"
msgstr ""
"\n"
"\t\t\t\t\t\t\t\t\tГэты карыстальнік падлучаны да знешняга правайдэра аўтэнтыфікацыі:<br />\n"
"\t\t\t\t\t\t\t\t\t<strong>%[1]s</strong>.<br />\n"
"\t\t\t\t\t\t\t\t\tТаму некаторыя з яго уласцівасцяў недаступныя для рэдагавання.<br />\n"
"\t\t\t\t\t\t\t\t\tГэта прывядзе да адключэння карыстальніка <strong>%[2]s</strong>.\n"
"\t\t\t\t\t\t\t\t"

