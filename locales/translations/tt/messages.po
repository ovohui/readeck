#: internal/dashboard/x-dashboard.templ:113
msgid "Welcome to Readeck!"
msgstr "Readeckка рәхим итегез!"

#: internal/auth/onboarding/x-onboarding.templ:21
msgid "We're delighted to have you on board; one more step and you're good to go."
msgstr "Сезне үзебезгә кушылуыгызга шатланабыз; тагын бер адым һәм сез яхшы буласыз."

#: internal/auth/onboarding/x-onboarding.templ:35
#: internal/auth/signin/x-auth.templ:170 internal/profile/x-security.templ:37
msgid "must be at least 8 characters long"
msgstr "кем дә 8 символдан кем дә күбрәк булырга тиеш"

#: internal/auth/onboarding/x-onboarding.templ:43
msgid "Please note:"
msgstr "Искәрмә:"

#: internal/auth/onboarding/x-onboarding.templ:44
msgid ""
"\n"
"\t\t\t\t\t\tYour email address is optional and will never leave this installation.\n"
"\t\t\t\t\t\tIt will never be collected, transferred or sold.\n"
"\t\t\t\t\t\tIt will <strong>only</strong> be used, should you need it, for password recovery and internal notifications.\n"
"\t\t\t\t\t"
msgstr ""
"\n"
"\t\t\t\t\t\tСезнең e-mail җиңел һәм бу инсталляциядән чыгарылмаячак.\n"
"\t\t\t\t\t\tУл җыю, күчерү яки сатылмаячак.\n"
"\t\t\t\t\t\tУл <strong>гына</strong> кулланылыр, әгәр кирәк булса, парольне калгызарга һәм эчке хәбәрләр өчен.\n"
"\t\t\t\t\t"

#: internal/auth/onboarding/x-onboarding.templ:52
msgid "Finish installation"
msgstr "Установка тәмамлау"

#: internal/auth/signin/forms.go:19
msgid "Invalid user and/or password"
