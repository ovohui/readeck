#: internal/admin/x-users.templ:227
msgid ""
"\n"
"\t\t\t\t\t\t\t\t\tThis user is attached to an external authentication provider:<br />\n"
"\t\t\t\t\t\t\t\t\t<strong>%[1]s</strong>.<br />\n"
"\t\t\t\t\t\t\t\t\tTherefore, some of their properties are not editable.<br />\n"
"\t\t\t\t\t\t\t\t\tThis will detach the user <strong>%[2]s</strong>.\n"
"\t\t\t\t\t\t\t\t"
msgstr ""
"\n"
"\t\t\t\t\t\t\t\t\tТози потребител е свързан с външен доставчик на услуги за удостоверяване:<br />\n"
"\t\t\t\t\t\t\t\t\t<strong>%[1]s</strong>.<br />\n"
"\t\t\t\t\t\t\t\t\tПоради това някои от неговите свойства не могат да бъдат редактирани.<br />\n"
"\t\t\t\t\t\t\t\t\tТова ще отдели потребителя <strong>%[2]s</strong>.\n"
"\t\t\t\t\t\t\t\t"

#: internal/admin/x-users.templ:240
msgid "Detach this user"
msgstr "Отстранете този потребител"

#: internal/admin/x-users.templ:249
#, python-format
