msgstr "Последно използван"

#: internal/profile/x-tokens.templ:123
msgid "never used"
msgstr "никога не е използван"

#: internal/profile/x-tokens.templ:133
msgid "Enabled"
msgstr "Активиран"

#: internal/profile/x-tokens.templ:137
msgid "Expires on"
msgstr "Изтича на"

#: internal/profile/x-tokens.templ:140 internal/profile/x-tokens.templ:149
