#: internal/admin/x-users.templ:227
msgid ""
"\n"
"\t\t\t\t\t\t\t\t\tThis user is attached to an external authentication provider:<br />\n"
"\t\t\t\t\t\t\t\t\t<strong>%[1]s</strong>.<br />\n"
"\t\t\t\t\t\t\t\t\tTherefore, some of their properties are not editable.<br />\n"
"\t\t\t\t\t\t\t\t\tThis will detach the user <strong>%[2]s</strong>.\n"
"\t\t\t\t\t\t\t\t"
msgstr ""
"\n"
"\t\t\t\t\t\t\t\t\tЭтот пользователь привязан к внешнему провайдеру авторизации:<br />\n"
"\t\t\t\t\t\t\t\t\t<strong>%[1]s</strong>.<br />\n"
"\t\t\t\t\t\t\t\t\tПоэтому ряд его свойств нельзя редактировать.<br />\n"
"\t\t\t\t\t\t\t\t\tЭто отвяжет пользователя <strong>%[2]s</strong>.\n"
"\t\t\t\t\t\t\t\t"

