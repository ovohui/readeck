#: internal/profile/x-security.templ:49
msgid "Verification Code (TOTP)"
msgstr "Overovací kód (TOTP)"

#: internal/profile/x-security.templ:50
msgid "A verification code is a one time code generated by an application, such as Google Authenticator."
msgstr "Overovací kód je jednorazový kód vygenerovaný aplikáciou, ako je napríklad Google Authenticator."

#: internal/profile/x-security.templ:55
msgid "The verification code is enabled on this account."
msgstr "Overovací kód je pre tento účet aktivovaný."

#: internal/profile/x-security.templ:59
msgid "Remove Verification Code"
msgstr "Odstrániť overovací kód"

#: internal/profile/x-security.templ:61
msgid "Removing your verification code will make your account less secure."
msgstr "Odstránením overovacieho kódu bude váš účet menej zabezpečený."

#: internal/profile/x-security.templ:67
msgid "Remove"
msgstr "Odstrániť"

#: internal/profile/x-security.templ:75 internal/profile/x-security.templ:85
msgid "Setup Verification Code"
msgstr "Nastaviť overovací kód"

#: internal/profile/x-security.templ:91
msgid "Scan this QR code with your app"
msgstr "Naskenujte tento QR kód svojou aplikáciou"

#: internal/profile/x-security.templ:92
msgid "Scan the QR code below with a two-factor authentication app on your phone."
msgstr "Naskenujte QR kód nižšie pomocou aplikácie na dvojfaktorové overenie vo vašom telefóne."

#: internal/profile/x-security.templ:101
msgid "If you can't use the QR code, enter the code below instead."
msgstr "Ak nemôžete použiť QR kód, zadajte namiesto neho kód uvedený nižšie."

#: internal/profile/x-security.templ:104
msgid "Enter the code from your application."
msgstr "Zadajte kód z vašej aplikácie."

#: internal/profile/x-security.templ:106
msgid "After scanning the QR code, the app will display a six-digit code that you need to enter below."
msgstr "Po naskenovaní QR kódu aplikácia zobrazí šesťmiestny kód, ktorý musíte zadať nižšie."

#: internal/profile/x-security.templ:109
msgid "Code from your device"
msgstr "Kód z vášho zariadenia"

#: internal/profile/x-security.templ:115
msgid "Finish"
msgstr "Dokončiť"

