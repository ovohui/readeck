#: internal/auth/onboarding/x-onboarding.templ:43
msgid "Please note:"
msgstr "Poznámka:"

#: internal/auth/onboarding/x-onboarding.templ:44
msgid ""
"\n"
"\t\t\t\t\t\tYour email address is optional and will never leave this installation.\n"
"\t\t\t\t\t\tIt will never be collected, transferred or sold.\n"
"\t\t\t\t\t\tIt will <strong>only</strong> be used, should you need it, for password recovery and internal notifications.\n"
"\t\t\t\t\t"
msgstr ""
"\n"
"\t\t\t\t\t\tVaša e-mailová adresa je voliteľná a nikdy neopustí túto inštaláciu.\n"
"\t\t\t\t\t\tNikdy nebude zbieraná, prenášaná ani predávaná.\n"
"\t\t\t\t\t\tBude <strong>iba</strong> použitá, ak ju budete potrebovať, na obnovenie hesla a vnútorné oznámenia.\n"
"\t\t\t\t\t"

#: internal/auth/onboarding/x-onboarding.templ:52
msgid "Finish installation"
msgstr "Dokončiť inštaláciu"

