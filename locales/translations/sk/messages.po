msgstr "API token je kľúč, ktorý vám umožňuje prístup k Readeck API."

#: internal/profile/x-tokens.templ:19
#, python-format
msgid "Please read the <a href=\"%s\">API Documentation</a> if you plan to use it."
msgstr "Ak ho plánujete používať, prečítajte si <a href=\"%s\">dokumentáciu k API</a>."

