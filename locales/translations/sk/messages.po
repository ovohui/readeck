msgstr "Tento token bude o niekoľko sekúnd odstránený."

#: internal/profile/x-tokens.templ:98
msgid "API Token"
msgstr "API token"

#: internal/profile/x-tokens.templ:105
msgid "Token will be removed in a few seconds."
msgstr "Token bude o niekoľko sekúnd odstránený."

#: internal/profile/x-tokens.templ:114
msgid "Token ID"
msgstr "ID tokenu"

#: internal/profile/x-tokens.templ:118
msgid "Last used"
msgstr "Naposledy použité"

#: internal/profile/x-tokens.templ:123
msgid "never used"
msgstr "nikdy nepoužité"

#: internal/profile/x-tokens.templ:133
msgid "Enabled"
msgstr "Povolené"

#: internal/profile/x-tokens.templ:137
msgid "Expires on"
msgstr "Vyprší dňa"

#: internal/profile/x-tokens.templ:140 internal/profile/x-tokens.templ:149
msgid "Roles"
msgstr "Roly"

#: internal/profile/x-tokens.templ:142
msgid ""
"\n"
"\t\t\t\t\tYou can limit the permissions granted to this token by choosing one or more\n"
"\t\t\t\t\tgroup of permissions below.<br>\n"
"\t\t\t\t\tLeave all the choices blank to grant all your permissions to this token.\n"
"\t\t\t\t"
msgstr ""
"\n"
"\t\t\t\t\tPovolenia udelené tomuto tokenu môžete obmedziť výberom jednej alebo viacerých\n"
"\t\t\t\t\tskupín povolení nižšie.<br>\n"
"\t\t\t\t\tAk ponecháte všetky možnosti nevybraté, tokenu budú udelené všetky vaše povolenia.\n"
"\t\t\t\t"

#: internal/profile/x-tokens.templ:158
msgid "Delete token"
msgstr "Odstrániť token"

#: internal/profile/x-tokens.templ:162
msgid "Authentication"
msgstr "Autentifikácia"

#: internal/profile/x-tokens.templ:164
msgid "Your API token"
msgstr "Váš API token"

#: internal/profile/x-tokens.templ:177
msgid "copy token"
msgstr "kopírovať token"

#: internal/profile/x-tokens.templ:191
msgid "Download as a text file"
msgstr "Stiahnuť ako textový súbor"

#: internal/profile/x-tokens.templ:194
msgid "How to use it"
msgstr "Ako ho použiť"

#: internal/profile/x-tokens.templ:195
msgid "As a Bearer Token"
msgstr "Ako Bearer Token"

#: internal/profile/x-tokens.templ:197
msgid "You can use this token by passing it as an <strong>Authorization: Bearer</strong> HTTP header."
msgstr "Tento token môžete použiť tak, že ho odošlete v HTTP hlavičke ako <strong>Authorization: Bearer</strong>."

#: internal/profile/x-tokens.templ:200
msgid "HTTP Header"
msgstr "HTTP hlavička"

#: internal/profile/x-tokens.templ:213
msgid "copy HTTP header"
msgstr "kopírovať HTTP hlavičku"

#: internal/profile/x-tokens.templ:219
msgid "As a password"
msgstr "Ako heslo"

#: internal/profile/x-tokens.templ:220
msgid "Alternatively, you can use this token as a password for HTTP Basic Authentication."
msgstr "Prípadne môžete tento token použiť ako heslo pre základnú HTTP autentifikáciu (Basic Authentication)."

#: internal/profile/x-tokens.templ:222
msgid ""
"\n"
"\t\t\t\tFor example, if an application only accepts a username and password, you can provide this token as a password.\n"
"\t\t\t\tThe username is ignored and can be anything, including an empty value.\n"
"\t\t\t"
msgstr ""
"\n"
"\t\t\t\tNapríklad, ak aplikácia vyžaduje iba používateľské meno a heslo, môžete tento token zadať ako heslo.\n"
"\t\t\t\tPoužívateľské meno sa ignoruje a môže byť akékoľvek, vrátane prázdnej hodnoty.\n"
"\t\t\t"

