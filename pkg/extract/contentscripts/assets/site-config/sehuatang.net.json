{
  "title_selectors": [
    "//meta[@property='og:title']/@content",
    "//span[@id='thread_subject']",
    "//h1"
  ],
  "body_selectors": [
    "//*[starts-with(@id,'postmessage_')]",
    "//td[contains(@class,'t_f')]",
    "//div[contains(@class,'t_fsz')]"
  ],
  "date_selectors": [
    "//em[@id='authorposton']",
    "//div[contains(@class,'authi')]//em"
  ],
  "author_selectors": [
    "//meta[@property='og:article:author']/@content",
    "//div[contains(@class,'authi')]//a[contains(@href,'space-uid')]"
  ],
  "strip_selectors": [
    "//div[contains(@class,'attach_nopermission')]",
    "//div[contains(@class,'sign')]",
    "//div[contains(@class,'rate')]",
    "//div[contains(@class,'pstatus')]",
    "//div[contains(@class,'quote')]",
    "//div[contains(@class,'ad')]",
    "//div[@id='comment']"
  ],
  "strip_id_or_class": [
    "sign",
    "attach_nopermission",
    "pstatus",
    "rate",
    "adshow",
    "ad",
    "forum-rules",
    "post-rate",
    "cm"
  ],
  "strip_image_src": [
    "static/image/common/none.gif",
    "static/image/common/emp.gif",
    "static/image/common/LOGO",
    "static/image/smiley"
  ],
  "native_ad_selectors": null,
  "tidy": false,
  "prune": false,
  "autodetect_on_failure": true,
  "single_page_link_selectors": null,
  "next_page_link_selectors": null,
  "replace_strings": null,
  "http_headers": {
    "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36",
    "accept-language": "zh-CN,zh;q=0.9,en;q=0.8"
  }
}
