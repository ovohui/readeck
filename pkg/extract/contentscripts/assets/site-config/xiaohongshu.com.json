{
  "title_selectors": [
    "//meta[@property='og:title']/@content",
    "//div[@id='detail-title']",
    "//h1"
  ],
  "body_selectors": [
    "//div[@id='noteContainer']",
    "//div[contains(@class, 'note-container')]",
    "//div[contains(@class, 'note-content')]",
    "//article"
  ],
  "date_selectors": [
    "//meta[@property='article:published_time']/@content"
  ],
  "author_selectors": [
    "//meta[@property='og:article:author']/@content",
    "//div[contains(@class, 'author-container')]//span[contains(@class, 'name')]"
  ],
  "strip_selectors": [
    "//div[contains(@class, 'comments')]",
    "//div[contains(@class, '互动')]"
  ],
  "strip_id_or_class": [
    "comments-container",
    "comment-list",
    "side-bar",
    "float-bar",
    "login-container",
    "红书外部展示"
  ],
  "strip_image_src": null,
  "native_ad_selectors": null,
  "tidy": false,
  "prune": false,
  "autodetect_on_failure": true,
  "single_page_link_selectors": null,
  "next_page_link_selectors": null,
  "replace_strings": null,
  "http_headers": {
    "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "accept-language": "zh-CN,zh;q=0.9,en;q=0.8"
  }
}
