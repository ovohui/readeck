{
  "title_selectors": [
    "//meta[@property='og:title'and not(contains(@content, ' | Deloitte'))]/@content",
    "substring-before(//meta[@property='og:title']/@content , ' | Deloitte')"
  ],
  "body_selectors": [
    "//div[contains(@class, 'bodyresponsivegridcontainer')]"
  ],
  "date_selectors": null,
  "author_selectors": null,
  "strip_selectors": [
    "//button",
    "//nav",
    "//script"
  ],
  "strip_id_or_class": [
    "article-info",
    "authors",
    "container-page-info",
    "diauthors",
    "disclaimer-modal",
    "feedbackbanner",
